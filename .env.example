# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/bookly

# Long random secret for signing access tokens (min 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated origins allowed by CORS (the mobile app doesn't need this; web tools do)
CORS_ORIGINS=http://localhost:8081

# Set to 1 when running behind a proxy / load balancer so rate limits see the real client IP
TRUST_PROXY=0

# --- Google sign-in (see src/modules/auth/google.ts) ---
# Comma-separated OAuth client IDs that may appear as the ID token's audience:
# the iOS client ID, the Android client ID and the web client ID used by the app.
GOOGLE_CLIENT_IDS=153004524173-79farmg2350m8opb24ehebbfvb589kut.apps.googleusercontent.com,153004524173-6tgdlk10bupn425s6c66qpoiqr2rdrag.apps.googleusercontent.com,153004524173-r9uujc86octpop4jvii7pkb1uv1bi1nu.apps.googleusercontent.com

# --- Cloudinary (photo uploads) ---
# Cloudinary Console → Settings (gear) → API Keys. Use the "Cloud name", "API Key" and "API Secret".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Top-level folder for Bookly's images in the Media Library
CLOUDINARY_FOLDER=bookly

