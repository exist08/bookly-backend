              "path": [
                "v1",
                "auth",
                "signout"
              ]
            },
            "description": "Revokes the stored refresh token. The access token stays valid until it expires (15 min), which is why the next request can still call Sign out everywhere.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
