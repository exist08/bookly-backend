    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "signup"
              ]
            },
            "description": "Creates an email/password account. `profileComplete` is false until a username is set with **Update profile**.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aarav Mehta\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.tokens) {",
                  "  pm.collectionVariables.set('accessToken', json.tokens.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.tokens.refreshToken);",
                  "}",
                  "if (json.user) pm.collectionVariables.set('userId', json.user.id);",
                  "pm.test('new account has no username yet', () => pm.expect(json.user.profileComplete).to.eql(false));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh email + username each run so the Collection Runner can repeat the flow.",
                  "const n = Date.now().toString(36);",
                  "pm.collectionVariables.set('email', `reader.${n}@example.com`);",
                  "pm.collectionVariables.set('username', `reader.${n}`.slice(0, 24));"
                ]
              }
            }
          ]
        },
